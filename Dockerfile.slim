# syntax=docker/dockerfile:1.7
# =============================================================================
#  Postiz – Multi-Stage "slim" Image
#
#  Unterschied zu Dockerfile.dev (single-stage):
#   - Builder-Stage: installiert ALLE Deps und baut die Apps.
#   - Runtime-Stage: enthält nur noch Prod-Dependencies + Build-Output + nginx.
#     g++/make/python3-pip (nur zum Bauen nötig) landen NICHT im finalen Image,
#     Dev-Dependencies werden per `pnpm prune --prod` entfernt.
#
#  Ziel: deutlich kleineres Image (~1/2) bei identischem Runtime-Verhalten
#  (CMD bleibt `nginx && pnpm run pm2`).
#
#  Hinweis: setzt voraus, dass `prisma` in den dependencies liegt und die
#  prisma-Skripte das lokale Binary nutzen (siehe package.json in diesem Branch).
# =============================================================================

# ---------------------------------------------------------------- Builder ----
FROM node:22.20-bookworm-slim AS builder

ARG NEXT_PUBLIC_VERSION=dev
ENV NEXT_PUBLIC_VERSION=$NEXT_PUBLIC_VERSION

# Build-Tools nur hier – nicht im finalen Image.
RUN apt-get update && apt-get install -y --no-install-recommends \
      g++ make python3-pip bash ca-certificates \
 && rm -rf /var/lib/apt/lists/*

RUN npm --no-update-notifier --no-fund --global install pnpm@10.6.1

WORKDIR /app
COPY . .

RUN pnpm install --frozen-lockfile
RUN NODE_OPTIONS="--max-old-space-size=4096" pnpm run build

# Dev-Dependencies entfernen (cross-env, typescript, nx, ...).
RUN pnpm prune --prod
# Prisma-Client im geprunten Baum neu erzeugen, damit die generierte Client-
# Ausgabe garantiert vorhanden bleibt.
RUN pnpm run prisma-generate

# ---------------------------------------------------------------- Runtime ----
FROM node:22.20-bookworm-slim AS runtime

ARG NEXT_PUBLIC_VERSION=dev
ENV NEXT_PUBLIC_VERSION=$NEXT_PUBLIC_VERSION

# Ohne g++/make/python. Nur was die Laufzeit braucht.
RUN apt-get update && apt-get install -y --no-install-recommends \
      bash nginx ca-certificates \
 && rm -rf /var/lib/apt/lists/*

RUN addgroup --system www \
 && adduser --system --ingroup www --home /www --shell /usr/sbin/nologin www \
 && mkdir -p /www \
 && chown -R www:www /www /var/lib/nginx

RUN npm --no-update-notifier --no-fund --global install pnpm@10.6.1 pm2

WORKDIR /app
COPY --from=builder /app /app
COPY var/docker/nginx.conf /etc/nginx/nginx.conf

CMD ["sh", "-c", "nginx && pnpm run pm2"]
